    {
      "name": "User Onboarding Flow",
      "item": [
        {
          "name": "Signup New Voter",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now().toString();",
                  "pm.environment.set('signupName', `Voter ${ts.slice(-4)}`);",
                  "pm.environment.set('signupEmail', `voter.${ts}@mail.local`);",
                  "pm.environment.set('signupCitizenshipNumber', ts.slice(-10));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Signup status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('pendingUserId', String(body.id));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{signupName}}\",\n  \"email\": \"{{signupEmail}}\",\n  \"citizenshipNumber\": \"{{signupCitizenshipNumber}}\",\n  \"password\": \"{{signupPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          }
        },
        {
          "name": "Admin List Pending Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "all"
              ]
            }
          }
        },
        {
          "name": "Admin Verify Pending User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{pendingUserId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "verify"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verify status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.user && body.user.id) { pm.environment.set('verifiedUserId', String(body.user.id)); }",
                  "if (body.user && body.user.voterId) { pm.environment.set('assignedVoterId', body.user.voterId); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Admin List Verified Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/verified",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "verified"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Voter Flow",
      "item": [
        {
          "name": "Login Verified Voter by Voter ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"voterId\": \"{{assignedVoterId}}\",\n  \"password\": \"{{signupPassword}}\"\n}"
