{
  "info": {
    "_postman_id": "bd39f3de-5d08-4ed7-a5d2-e09722fa3fb2",
    "name": "BBVS API",
    "description": "Postman collection for end-to-end testing of Blockchain Based Voting System APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Ping response is valid', function () {",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.message).to.eql('pong');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
