              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Voter login status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('voterAccessToken', body.accessToken || '');",
                  "if (body.user) {",
                  "  pm.environment.set('currentUserId', String(body.user.id || ''));",
                  "  pm.environment.set('currentUserName', body.user.name || '');",
                  "  pm.environment.set('currentVoterId', body.user.voterId || '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
